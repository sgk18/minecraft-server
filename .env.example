# ==============================================================================
# Minecraft Bedrock & Azure Vercel Environment Configuration
# Add these variables to your Vercel Project Settings > Environment Variables
# ==============================================================================

# 1. Minecraft Bedrock Server Connection
MINECRAFT_SERVER_HOST=minesvrbedrock.centralindia.azurecontainer.io
MINECRAFT_SERVER_PORT=19132
SERVER_NAME=sgkserver

# 2. Azure Infrastructure Metadata
AZURE_REGION=centralindia
AZURE_RESOURCE_GROUP=minecraftResGroup
AZURE_CONTAINER_NAME=minecotainer
AZURE_STORAGE_ACCOUNT=surymineacc
AZURE_STORAGE_SHARE=acismineshare

# 3. Optional: Azure Service Principal (for live Azure Container CPU / RAM / Uptime telemetry)
# If left blank, server status and players are fetched via Bedrock RakNet query.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
